# ---- Copia este fichero a .env para desarrollo local ----

# Entorno: development | production (en production se exige SECRET_KEY y GOOGLE_CLIENT_ID)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Base de datos (Railway la inyecta automáticamente)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lectura_educativa

# Autenticación
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria
GOOGLE_CLIENT_ID=1016751986529-b87941fcfc310qut1am83t7fe5b0rvcl.apps.googleusercontent.com
VALID_ACCESS_KEY=clave-para-docentes
# ADMIN_ACCESS_KEY=   (opcional; se acepta como clave válida pero ya NO da permisos de admin)
CORS_ORIGINS=http://localhost:8000,http://localhost:3000

# IA (se acepta también el nombre antiguo MI_ANTHROPIC_KEY)
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5-20250929
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
MAX_TOKENS_ADAPTACION=5000
MAX_TOKENS_IMAGENES=1500
MAX_TOKENS_PICTOGRAMAS=1500

# Idiomas
DEFAULT_LANGUAGE=es

# ---- Prompts (para experimentos) ----
# Carpeta alternativa con prompts (solo necesita los que cambian)
# PROMPTS_DIR=/ruta/a/prompts_experimento_3
# Releer los prompts del disco en cada petición mientras los afinas
PROMPTS_HOT_RELOAD=false
# Etiqueta que se guarda con cada transformación: prompt_version = "exp3:1a2b3c4d"
# PROMPT_SET_NAME=exp3
# Sustituir un prompt concreto (texto completo o fichero):
# PROMPT_ADAPTAR_SYSTEM_ES="..."
# PROMPT_ADAPTAR_SYSTEM_EN_FILE=/ruta/a/adaptar_system_en.md

# Fuente para las etiquetas de los pictogramas (opcional)
# PICTOGRAM_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
