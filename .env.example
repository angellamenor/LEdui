# ---- Copy this file to .env for local development ----

# Environment: development | production (production requires SECRET_KEY and GOOGLE_CLIENT_ID)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database (Railway injects it automatically). For a quick local test: sqlite:///./ledui.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lectura_educativa

# Authentication
SECRET_KEY=replace-with-a-long-random-string
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VALID_ACCESS_KEY=key-for-teachers
# ADMIN_ACCESS_KEY=   (optional; accepted as a valid key but does NOT grant admin rights)
CORS_ORIGINS=http://localhost:8000,http://localhost:3000

# AI (the legacy name MI_ANTHROPIC_KEY is also accepted)
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5-20250929
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
MAX_TOKENS_ADAPTACION=5000
MAX_TOKENS_IMAGENES=1500
MAX_TOKENS_PICTOGRAMAS=1500

# Languages
DEFAULT_LANGUAGE=es

# ---- Prompts (for experiments) ----
# Alternative prompts folder (only needs the files you change)
# PROMPTS_DIR=/path/to/prompts_experiment_3
# Re-read prompts from disk on every request while tuning them
PROMPTS_HOT_RELOAD=false
# Label stored with every transformation: prompt_version = "exp3:1a2b3c4d"
# PROMPT_SET_NAME=exp3
# Override a single prompt (full text or file):
# PROMPT_ADAPTAR_SYSTEM_ES="..."
# PROMPT_ADAPTAR_SYSTEM_EN_FILE=/path/to/adaptar_system_en.md

# Font for the pictogram labels (optional)
# PICTOGRAM_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
